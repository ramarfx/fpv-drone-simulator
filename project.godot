; Engine configuration file.
; FPV Drone Simulator — Godot 4.3
config_version=5

[application]
config/name="FPV Drone Simulator"
config/description="FPV Drone Simulator - fisika realistis, low-poly, Android"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=4
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.529, 0.808, 0.922, 1)

[physics]
common/physics_ticks_per_second=240
common/run_physics_separately=true
3d/run_physics_separately=true

[layer_names]
3d_physics/layer_1="Default"
3d_physics/layer_2="Drone"
3d_physics/layer_3="Gate"

